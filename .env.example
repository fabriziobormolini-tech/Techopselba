# ----------------------------------------------------------------------------
# Wayrd environment configuration
# Copy to `.env` and fill in real values to switch from mocks to live services.
# Everything runs out-of-the-box with mocks if these are left unset.
# ----------------------------------------------------------------------------

# Database (SQLite for local dev; swap for a Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Signing secret for session cookies (CHANGE THIS in production)
SESSION_SECRET="dev-insecure-change-me"

# Public base URL of the app (used to build guest links)
APP_BASE_URL="http://localhost:3000"

# Protects the monitoring cron endpoint (/api/cron/poll)
CRON_SECRET="dev-cron-secret"

# --- Flight data provider --------------------------------------------------
# FLIGHT_PROVIDER: "mock" (default) | "aerodatabox"
FLIGHT_PROVIDER="mock"
AERODATABOX_API_KEY=""
AERODATABOX_API_HOST="aerodatabox.p.rapidapi.com"

# --- Messaging provider (WhatsApp) -----------------------------------------
# MESSAGING_PROVIDER: "mock" (default) | "whatsapp"
MESSAGING_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="wayrd-verify"
WHATSAPP_API_VERSION="v20.0"

# --- Billing provider (Stripe) ---------------------------------------------
# BILLING_PROVIDER: "mock" (default) | "stripe"
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
