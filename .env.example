# Database (Supabase or any PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/techopselba"

# Redis (for BullMQ queue)
REDIS_URL="redis://localhost:6379"

# Google Cloud Vision API
GOOGLE_CLOUD_API_KEY="your-google-cloud-api-key"
GOOGLE_CLOUD_PROJECT_ID="your-project-id"

# OpenAI (for complex reason analysis)
OPENAI_API_KEY="your-openai-api-key"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Certification price in cents (e.g. 2500 = €25.00)
CERTIFICATION_PRICE_CENTS=2500

# AWS S3 (document storage)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="techopselba-documents"
AWS_REGION="eu-west-1"

# Blockchain (Polygon)
POLYGON_RPC_URL="https://polygon-rpc.com"
POLYGON_PRIVATE_KEY="your-wallet-private-key"
CERTIFICATION_CONTRACT_ADDRESS="0x..."
